MONGO_URI=mongodb://localhost:27017/
SECRET_KEY=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:5173
ORS_API_KEY=replace-with-openrouteservice-api-key
WEATHER_API_KEY=replace-with-openweather-api-key
UNSPLASH_API_KEY=replace-with-unsplash-access-key
TRAFFIC_API_KEY=replace-with-traffic-api-key
TRAGGIC_API_KEY=replace-with-traffic-api-key
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Gmail SMTP requires a Google app password, not your normal Gmail password.
GMAIL_SMTP_USER=your-gmail-address@gmail.com
GMAIL_SMTP_PASSWORD=your-16-character-google-app-password
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
